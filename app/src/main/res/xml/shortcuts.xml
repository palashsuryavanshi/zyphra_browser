<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_tab"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/new_tab"
        android:shortcutLongLabel="@string/new_tab">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.zyphra.browser.MainActivity"
            android:targetPackage="com.zyphra.browser" />
    </shortcut>
    <shortcut
        android:shortcutId="private_tab"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/new_private_tab"
        android:shortcutLongLabel="@string/new_private_tab">
        <intent
            android:action="com.zyphra.browser.PRIVATE_TAB"
            android:targetClass="com.zyphra.browser.MainActivity"
            android:targetPackage="com.zyphra.browser" />
    </shortcut>
</shortcuts>
